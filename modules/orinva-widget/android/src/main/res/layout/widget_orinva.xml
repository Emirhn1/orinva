<?xml version="1.0" encoding="utf-8"?>
<!--
  Full, unlocked-state layout: behavior name, clean-time progress and
  estimated savings, plus a direct "Zor an" (craving-help) action —
  the two things Part 4 asks a home-screen widget to lead with.
  No live-ticking counter here: values are static text set from the last
  synced snapshot, redrawn only when the app pushes new data.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_behavior_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8890A3"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Sigara" />

    <TextView
        android:id="@+id/widget_clean_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#F4F5F9"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="3g 4sa" />

    <TextView
        android:id="@+id/widget_savings_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#8890A3"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="₺240 (tahmini)" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zor an →"
        android:textColor="#4E5FB8"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
